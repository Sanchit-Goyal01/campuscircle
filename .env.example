NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only: issue reporting (src/modules/issues/submit.ts) and tests. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_DAILY_RUN_LIMIT=30
STUDY_HELP_DAILY_LIMIT=40
# IANA timezone the assistant uses for "today"
AGENT_TIMEZONE=Asia/Kolkata
# set to 1 only in e2e tests
AGENT_TEST_MODEL=
