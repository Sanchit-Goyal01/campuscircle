NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only: issue reporting (src/modules/issues/submit.ts) and tests. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider for the agent and classifier: "claude" (default) or "groq" (free tier)
AI_PROVIDER=groq
GROQ_API_KEY=
# optional overrides; defaults are openai/gpt-oss-120b and llama-3.1-8b-instant
GROQ_AGENT_MODEL=
GROQ_CLASSIFIER_MODEL=
# only needed when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_DAILY_RUN_LIMIT=30
STUDY_HELP_DAILY_LIMIT=40
# IANA timezone the assistant uses for "today"
AGENT_TIMEZONE=Asia/Kolkata
# set to 1 only in e2e tests
AGENT_TEST_MODEL=
